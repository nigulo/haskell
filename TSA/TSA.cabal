name:                TSA
version:             0.0.1
cabal-version:       >= 1.10
build-type:          Simple
license:             AllRightsReserved
extra-source-files:
extra-tmp-files:
executable TSA
  build-depends:
               GUI -any,
               Math -any,
               Regression -any,
               Utils -any,
               array -any,
               base -any,
               cairo -any,
               gi-gtk >= 4.0,
               gi-gdk >= 4.0,
               gi-gio -any,
               gi-glib -any,
               gi-gobject -any,
               gi-cairo -any,
               gi-cairo-render -any,
               gi-cairo-connector -any,
               haskell-gi-base -any,
               text -any,
               containers -any,
               directory -any,
               gnuplot -any,
               random -any,
               transformers -any,
               ISDA -any,
               SafeSemaphore -any,
               statistics -any,
               vector -any,
               statistics-linreg -any,
               monad-parallel -any,
               mwc-random -any,
               zlib -any,
               bytestring -any,
               utf8-string -any,
               utility-ht -any,
               filepath -any,
               time -any

  hs-source-dirs:  src
  ghc-options:     -O2 -fexcess-precision -rtsopts -threaded
  main-is:         Main.hs
  default-language: Haskell2010
  default-extensions:
               DoAndIfThenElse,
               ScopedTypeVariables,
               OverloadedStrings,
               OverloadedLabels
  other-modules:   TSA.AnalyticSignal,
                TSA.CommonParams,
                TSA.Correlation,
                TSA.D2,
                TSA.Data,
                TSA.Envelopes,
                TSA.Interpolate,
                TSA.LeastSquares,
                TSA.Params,
                TSA.Period,
                TSA.RegressionParams,
                TSA.SpecificPoints,
                TSA.GUI.AnalyticSignal,
                TSA.GUI.Attractor,
                TSA.GUI.Bayes,
                TSA.GUI.Build,
                TSA.GUI.Common,
                TSA.GUI.Correlation,
                TSA.GUI.D2,
                TSA.GUI.Data,
                TSA.GUI.Dialog,
                TSA.GUI.Envelopes,
                TSA.GUI.FFT,
                TSA.GUI.Function,
                TSA.GUI.Gnu,
                TSA.GUI.Graph,
                TSA.GUI.Interpolate,
                TSA.GUI.IO,
                TSA.GUI.LeastSquares,
                TSA.GUI.LocalPhase,
                TSA.GUI.Log,
                TSA.GUI.Markers,
                TSA.GUI.Modify,
                TSA.GUI.Period,
                TSA.GUI.Preferences,
                TSA.GUI.Sample,
                TSA.GUI.Selection,
                TSA.GUI.SpecificPoints,
                TSA.GUI.State,
                TSA.GUI.Statistic,
                TSA.GUI.TaskManager

